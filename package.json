{
  "name": "campestre-tv",
  "private": true,
  "type": "module",
  "description": "Campestre TV - Transmissão ao vivo das quadras de tênis do Campestre.",
  "repository": {
    "type": "git",
    "url": "git@github.com:brenopolanski/campestre-tv.git"
  },
  "license": "MIT",
  "author": {
    "name": "Breno Polanski",
    "email": "breno.polanski@gmail.com",
    "url": "https://github.com/brenopolanski"
  },
  "portless": {
    "name": "campestre-tv",
    "script": "dev:next"
  },
  "scripts": {
    "build": "next build",
    "check:fix": "pnpm format && pnpm lint:fix && pnpm typecheck",
    "clean": "/bin/bash scripts/clean.sh",
    "dev": "portless",
    "dev:next": "next dev --turbopack",
    "format": "pnpm prettier --write",
    "format:check": "pnpm prettier --check",
    "lint": "eslint .",
    "lint:fix": "pnpm lint --fix",
    "lint-staged": "lint-staged",
    "preinstall": "npx only-allow pnpm",
    "prepare": "husky",
    "prettier": "prettier \"**/*.{js,mjs,ts,tsx,css,json,md}\"",
    "start": "portless --script start:next",
    "start:next": "next start",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@tanstack/react-query": "^5.104.2",
    "@vercel/analytics": "^2.0.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "env.style": "^1.0.1",
    "lucide-react": "^1.48.0",
    "motion": "^13.5.1",
    "next": "16.3.4",
    "nuqs": "^2.10.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-youtube": "^10.1.0",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@shadcn/lint": "^0.2.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^10",
    "eslint-config-next": "16.3.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "husky": "^9.1.7",
    "jsdom": "^30.1.2",
    "lint-staged": "^17.5.0",
    "portless": "^0.15.6",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.3"
  }
}
